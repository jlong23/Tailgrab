                                            <!-- Selected -->
                                            <Label Grid.Row="3" Grid.Column="0" Content="Selected:" VerticalAlignment="Center" Foreground="#FFE6E6E6"/>
                                            <ComboBox Grid.Row="3" Grid.Column="1" Name="SelectedBackgroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedSelectedBackground, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>
                                            <ComboBox Grid.Row="3" Grid.Column="2" Name="SelectedForegroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedSelectedForeground, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>

                                            <!-- Yellow -->
                                            <Label Grid.Row="4" Grid.Column="0" Content="Class 1:" VerticalAlignment="Center" Foreground="#FFE6E6E6"/>
                                            <ComboBox Grid.Row="4" Grid.Column="1" Name="Class01BackgroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedClass01Background, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>
                                            <ComboBox Grid.Row="4" Grid.Column="2" Name="Class01ForegroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedClass01Foreground, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>

                                            <!-- Red -->
                                            <Label Grid.Row="5" Grid.Column="0" Content="Class 2:" VerticalAlignment="Center" Foreground="#FFE6E6E6"/>
                                            <ComboBox Grid.Row="5" Grid.Column="1" Name="Class02BackgroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedClass02Background, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>
                                            <ComboBox Grid.Row="5" Grid.Column="2" Name="Class02ForegroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedClass02Foreground, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>

                                            <!-- Purple -->
                                            <Label Grid.Row="6" Grid.Column="0" Content="Class 3:" VerticalAlignment="Center" Foreground="#FFE6E6E6"/>
                                            <ComboBox Grid.Row="6" Grid.Column="1" Name="Class03BackgroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedClass03Background, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>
                                            <ComboBox Grid.Row="6" Grid.Column="2" Name="Class03ForegroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedClass03Foreground, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>
                                            <!-- Purple -->
                                            <Label Grid.Row="7" Grid.Column="0" Content="Class 4:" VerticalAlignment="Center" Foreground="#FFE6E6E6"/>
                                            <ComboBox Grid.Row="7" Grid.Column="1" Name="Class04BackgroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedClass04Background, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>
                                            <ComboBox Grid.Row="7" Grid.Column="2" Name="Class04ForegroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedClass04Foreground, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>

                                        </Grid>
                                    </GroupBox>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                        <Button Name="ColorConfigSaveButton" Content="Save Colors" Width="120" Margin="0,0,12,0" Click="SaveColors_Click"/>
                                        <Button Name="ColorConfigResetButton" Content="Reset to Defaults" Width="140" Click="ResetColors_Click"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Open Logs">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ListView Name="OpenLogsListView" ItemsSource="{Binding OpenLogsView}" Grid.Row="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Width="400">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="Filename" Tag="FileName" Click="GridViewColumnHeader_Click"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="180">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="Opened" Tag="StartTime" Click="GridViewColumnHeader_Click"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StartTime, StringFormat={}{0:u}}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="180">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="Last Line Processed" Tag="LastLineProcessedTime" Click="GridViewColumnHeader_Click"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding LastLineProcessedTimeFormatted}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="120">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="Lines Processed" Tag="LinesProcessed" Click="GridViewColumnHeader_Click"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding LinesProcessed, StringFormat=N0}" Width="100"
                                                                   HorizontalAlignment="Right" 
                                                                   TextAlignment="Right"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="80">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="Action" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Cancel" Click="CancelTailTask_Click" Padding="4,2" Tag="{Binding}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Migration" IsEnabled="False">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" 
                                           Text="Import Avatar Database" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Margin="0,0,0,16"
                                           Foreground="White"/>

                                <!-- File Selection Section -->
                                <GroupBox Header="Select prior version avatars.sqlite File" Grid.Row="1" Margin="0,0,0,12">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" 
                                               Content="File Path:" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                                                 Name="MigrationFilePathTextBox" 
                                                 IsReadOnly="True" 
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Row="0" Grid.Column="2" 
                                                Content="Browse..." 
                                                Click="MigrationBrowse_Click" 
                                                Width="100"
                                                Padding="4,2"/>
                                    </Grid>
                                </GroupBox>

                                <!-- Spacer -->
                                <Grid Grid.Row="2"/>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="3" 
                                            Orientation="Horizontal" 
                                            HorizontalAlignment="Center" 
                                            Margin="0,12,0,0">
                                    <Button Name="MigrationCancelButton" 
                                            Content="Cancel" 
                                            Width="120" 
                                            Margin="0,0,12,0" 
                                            Click="MigrationCancel_Click"/>
                                    <Button Name="MigrationSubmitButton" 
                                            Content="Submit" 
                                            Width="120" 
                                            Click="MigrationSubmit_Click"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Ban Management" Height="23" VerticalAlignment="Top">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" 
                                           Text="Group Ban Management" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Margin="0,0,0,16"
                                           Foreground="White"/>

                                <!-- User ID Input Section -->
                                <GroupBox Header="User Lookup" Grid.Row="1" Margin="0,0,0,12">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" 
                                               Content="User ID:" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                                                 Name="BanMgmtUserIdTextBox" 
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Row="0" Grid.Column="2" 
                                                Content="Load User" 
                                                Click="BanMgmtLoadUser_Click" 
                                                Width="100"
                                                Padding="4,2"
                                                Margin="0,0,8,0"/>
                                        <Button Grid.Row="0" Grid.Column="3" 
                                                Content="Report User" 
                                                Click="BanMgmtReportUser_Click" 
                                                Width="100"
                                                Padding="4,2"
                                                Margin="0,0,8,0"/>
                                        <Button Grid.Row="0" Grid.Column="4" 
                                                Content="Check Groups" 
                                                Click="BanMgmtCheckGroups_Click" 
                                                Width="100"
                                                Padding="4,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="5"
                                                   Name="BanMgmtUserStatusText"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   Foreground="Yellow"/>
                                    </Grid>
                                </GroupBox>

                                <!-- User Info Display Section -->
                                <GroupBox Header="User Information" Grid.Row="2" Margin="0,0,0,12" Name="BanMgmtUserInfoGroup" Visibility="Collapsed">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Profile Image -->
                                        <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                               Name="BanMgmtUserImage"
                                               Width="120" Height="80"
                                               Margin="0,0,12,0"
                                               Stretch="UniformToFill"
                                               VerticalAlignment="Top"/>

                                        <!-- User Details -->
                                        <Label Grid.Row="0" Grid.Column="1" Content="User Name:" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Name="BanMgmtUserName" VerticalAlignment="Center"/>

                                        <Label Grid.Row="1" Grid.Column="1" Content="Status:" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Name="BanMgmtUserStatusDesc" VerticalAlignment="Center"/>

                                        <Label Grid.Row="2" Grid.Column="1" Content="Pronouns:" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Name="BanMgmtUserPronouns" VerticalAlignment="Center"/>

                                        <Label Grid.Row="0" Grid.Column="3" Content="Join Date:" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="0" Grid.Column="4" Name="BanMgmtUserJoinDate" VerticalAlignment="Center"/>

                                        <Label Grid.Row="1" Grid.Column="3" Content="Age Verified:" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Grid.Column="4" Name="BanMgmtUserAgeVerified" VerticalAlignment="Center"/>

                                        <Label Grid.Row="2" Grid.Column="3" Content="State:" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Grid.Column="4" Name="BanMgmtUserState" VerticalAlignment="Center"/>
                                    </Grid>
                                </GroupBox>

                                <!-- Group Ban Management Section -->
                                <GroupBox Header="Group Ban Status" Grid.Row="3" Margin="0,0,0,0" Name="BanMgmtGroupListGroup" Visibility="Visible">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Row -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="Group Id" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,4,0"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="Group Name" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="Status" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="3" 
                                                       Text="Remove" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="4" 
                                                       Text="" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="5" 
                                                       Text="Ban" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="6" 
                                                       Text="Unban" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                        </Grid>

                                        <!-- All Groups Row -->
                                        <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="0,0,0,2" Padding="4" Margin="0,0,0,4" Background="#FF3E3E42">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="300"/>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="1" 
                                                           Text="All Groups" 
                                                           FontStyle="Italic"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0"/>
