                                                      ItemsSource="{Binding ColorOptions}" 
                                                      SelectedValue="{Binding SelectedFriendBackground, Mode=TwoWay}"
                                                      ItemTemplate="{StaticResource SingleColorItemTemplate}"/>
                                            <ComboBox Grid.Row="2" Grid.Column="2" Name="FriendForegroundCombo" Margin="4,2"
                                                      ItemsSource="{Binding ColorOptions}" 
