                                                                    <Viewbox Width="32" Height="32" 
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,4,0">
                                                                        <Canvas Width="32" Height="32">
                                                                            <Path Data="{Binding AlertInfo.IconGeometry}" 
                                                                                  Fill="{Binding AlertInfo.IconBrush}"
                                                                                  Stretch="UniformToFill"
                                                                                  Width="24" Height="24"/>
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <TextBlock Text="{Binding AlertInfo.Description}" 
                                                                               VerticalAlignment="Center"
                                                                               TextWrapping="NoWrap"
                                                                               FontWeight="Bold"
                                                                               FontSize="12"
                                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"/>
                                                                </StackPanel>
                                                            </Border>

