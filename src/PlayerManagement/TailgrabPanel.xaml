                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="{DynamicResource UI.Tab.OpenLogs.Column.StartTime}" Tag="StartTime" Click="GridViewColumnHeader_Click"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StartTime, StringFormat={}{0:u}}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="180">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="{DynamicResource UI.Tab.OpenLogs.Column.LastLineProcessedTime}" Tag="LastLineProcessedTime" Click="GridViewColumnHeader_Click"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding LastLineProcessedTimeFormatted}" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="120">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="{DynamicResource UI.Tab.OpenLogs.Column.LinesProcessed}" Tag="LinesProcessed" Click="GridViewColumnHeader_Click"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding LinesProcessed, StringFormat=N0}" Width="100"
                                                                   HorizontalAlignment="Right" 
                                                                   TextAlignment="Right"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>

                                            <GridViewColumn Width="80">
                                                <GridViewColumn.Header>
                                                    <GridViewColumnHeader Content="{DynamicResource UI.Tab.OpenLogs.Column.ActionColumn}" />
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{DynamicResource UI.Tab.OpenLogs.Action.Close}" Click="CancelTailTask_Click" Padding="4,2" Tag="{Binding}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </TabItem>
                        <!-- #endregion Config / Open Logs Tab -->

                        <!-- #region Config / Ban Management Tab -->
                        <TabItem Header="Ban Management" Name="BanManagementTab">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" 
                                           Text="Group Ban Management" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Margin="0,0,0,16"
                                           Foreground="White"/>

                                <!-- User ID Input Section -->
                                <GroupBox Header="{DynamicResource UI.Tab.BanManagement.Group.UserLookup}" Grid.Row="1" Margin="0,0,0,12">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" 
                                               Content="{DynamicResource UI.Tab.BanManagement.Group.UserId}" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Right"
                                               Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" 
                                                 Name="BanMgmtUserIdTextBox" 
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Row="0" Grid.Column="2" 
                                                Content="{DynamicResource UI.Tab.BanManagement.Group.Action.LoadUser}" 
                                                Click="BanMgmtLoadUser_Click" 
                                                Width="100"
                                                Padding="4,2"
                                                Margin="0,0,8,0"/>
                                        <Button Grid.Row="0" Grid.Column="3" 
                                                Content="{DynamicResource UI.Tab.BanManagement.Group.Action.ReportUser}" 
                                                Click="BanMgmtReportUser_Click" 
                                                Width="100"
                                                Padding="4,2"
                                                Margin="0,0,8,0"/>
                                        <Button Grid.Row="0" Grid.Column="4" 
                                                Content="{DynamicResource UI.Tab.BanManagement.Group.Action.CheckGroups}" 
                                                Click="BanMgmtCheckGroups_Click" 
                                                Width="100"
                                                Padding="4,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="5"
                                                   Name="BanMgmtUserStatusText"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   Foreground="Yellow"/>
                                    </Grid>
                                </GroupBox>

                                <!-- User Info Display Section -->
                                <GroupBox Header="User Information" Grid.Row="2" Margin="0,0,0,12" Name="BanMgmtUserInfoGroup" Visibility="Collapsed">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Profile Image -->
                                        <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                               Name="BanMgmtUserImage"
                                               Width="120" Height="80"
                                               Margin="0,0,12,0"
                                               Stretch="UniformToFill"
                                               VerticalAlignment="Top"/>

                                        <!-- User Details -->
                                        <Label Grid.Row="0" Grid.Column="1" Content="{DynamicResource UI.Tab.BanManagement.Group.UserName}" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Name="BanMgmtUserName" VerticalAlignment="Center"/>

                                        <Label Grid.Row="1" Grid.Column="1" Content="{DynamicResource UI.Tab.BanManagement.Group.UserStatus}" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Name="BanMgmtUserStatusDesc" VerticalAlignment="Center"/>

                                        <Label Grid.Row="2" Grid.Column="1" Content="{DynamicResource UI.Tab.BanManagement.Group.UserPronouns}" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Name="BanMgmtUserPronouns" VerticalAlignment="Center"/>

                                        <Label Grid.Row="0" Grid.Column="3" Content="{DynamicResource UI.Tab.BanManagement.Group.UserJoinDate}" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="0" Grid.Column="4" Name="BanMgmtUserJoinDate" VerticalAlignment="Center"/>

                                        <Label Grid.Row="1" Grid.Column="3" Content="{DynamicResource UI.Tab.BanManagement.Group.UserAgeVerified}" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="1" Grid.Column="4" Name="BanMgmtUserAgeVerified" VerticalAlignment="Center"/>

                                        <Label Grid.Row="2" Grid.Column="3" Content="{DynamicResource UI.Tab.BanManagement.Group.State}" FontWeight="Bold" Margin="0,0,8,0" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Grid.Column="4" Name="BanMgmtUserState" VerticalAlignment="Center"/>
                                    </Grid>
                                </GroupBox>

                                <!-- Group Ban Management Section -->
                                <GroupBox Header="{DynamicResource UI.Tab.BanManagement.Group.GroupBanStatus}" Grid.Row="3" Margin="0,0,0,0" Name="BanMgmtGroupListGroup" Visibility="Visible">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Row -->
                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" 
                                                       Text="{DynamicResource UI.Tab.BanManagement.Group.GroupId}" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,4,0"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{DynamicResource UI.Tab.BanManagement.Group.GroupName}" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{DynamicResource UI.Tab.BanManagement.Group.GroupStatus}" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="3" 
                                                       Text="{DynamicResource UI.Tab.BanManagement.Group.GroupRemove}" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="4" 
                                                       Text="" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="5" 
                                                       Text="{DynamicResource UI.Tab.BanManagement.Group.BanColumn}" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                            <TextBlock Grid.Column="6" 
                                                       Text="{DynamicResource UI.Tab.BanManagement.Group.UnbanColumn}" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"/>
                                        </Grid>

                                        <!-- All Groups Row -->
                                        <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="0,0,0,2" Padding="4" Margin="0,0,0,4" Background="#FF3E3E42">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="300"/>
                                                    <ColumnDefinition Width="250"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="1" 
                                                           Text="{DynamicResource UI.Tab.BanManagement.Group.AllGroups}" 
                                                           FontStyle="Italic"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0"/>
                                                <Button Grid.Column="5" 
                                                        Content="{DynamicResource UI.Tab.BanManagement.Action.BanAll}" 
                                                        Click="BanMgmtBanAllGroups_Click"
                                                        Padding="4,2"
                                                        Margin="4,0"/>
                                                <Button Grid.Column="6" 
                                                        Content="{DynamicResource UI.Tab.BanManagement.Action.UnbanAll}" 
                                                        Click="BanMgmtUnbanAllGroups_Click"
                                                        Padding="4,2"
                                                        Margin="4,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Group List -->
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                                            <ItemsControl Name="BanMgmtGroupList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="4" Margin="0,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="300"/>
                                                                    <ColumnDefinition Width="250"/>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" 
                                                                           Text="{Binding GroupId}" 
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0"/>
                                                                <TextBlock Grid.Column="1" 
                                                                           Text="{Binding GroupName}" 
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0"/>
                                                                <TextBlock Grid.Column="2" 
                                                                           Text="{Binding Status}" 
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0"
                                                                           Foreground="{Binding StatusColor}"/>
                                                                <Button Grid.Column="3" 
                                                                        Content="{DynamicResource UI.Tab.BanManagement.Action.RemoveGroup}" 
                                                                        Click="BanMgmtRemoveGroup_Click"
                                                                        Tag="{Binding}"
                                                                        Padding="4,2"
                                                                        Margin="4,0"/>
                                                                <Button Grid.Column="5" 
                                                                        Content="{DynamicResource UI.Tab.BanManagement.Action.Ban}" 
                                                                        Click="BanMgmtBanUser_Click"
                                                                        Tag="{Binding}"
                                                                        IsEnabled="{Binding CanBan}"
                                                                        Padding="4,2"
                                                                        Margin="4,0"/>
                                                                <Button Grid.Column="6" 
                                                                        Content="{DynamicResource UI.Tab.BanManagement.Action.Unban}" 
                                                                        Click="BanMgmtUnbanUser_Click"
                                                                        Tag="{Binding}"
                                                                        IsEnabled="{Binding CanUnban}"
                                                                        Padding="4,2"
                                                                        Margin="4,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Add Group Section -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Label Grid.Column="0" 
                                                   Content="{DynamicResource UI.Tab.BanManagement.AddGroup}" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" 
                                                     Name="BanMgmtAddGroupIdTextBox"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" 
                                                    Content="{DynamicResource UI.Tab.BanManagement.Action.AddGroup}" 
                                                    Click="BanMgmtAddGroup_Click"
                                                    Padding="4,2"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </TabItem>
                        <!-- #endregion Config / Ban Management Tab -->
                    </TabControl>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- #region User Avatar Management Overlay -->
        <Border Name="UserAvatarOverlay" 
                Background="#CC000000" 
                Panel.ZIndex="{x:Static local:TailgrabPanelConst.ZINDEX_LEVEL_OVERLAY}"
                Visibility="Collapsed">
            <Border Background="#FF2D2D30"
                    Height="600" Width="1080"
                    MaxWidth="1080"  MaxHeight="700" 
                    CornerRadius="8" Padding="16"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" 
                               Text="User Avatar Management" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#FFE6E6E6"
                               Margin="0,0,0,16"/>

                    <!-- User Info Section -->
                    <GroupBox Grid.Row="1" Header="{DynamicResource UI.Overlay.UserAvatar.Group.Title}" Margin="0,0,0,12">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource UI.Overlay.UserAvatar.Group.UserId}" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Name="UserAvatarOverlayUserId" VerticalAlignment="Center"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource UI.Overlay.UserAvatar.Group.DisplayName}" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Name="UserAvatarOverlayDisplayName" VerticalAlignment="Center"/>
                        </Grid>
                    </GroupBox>

                    <!-- Avatar List -->
                    <ScrollViewer Name="UserAvatarScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <DataGrid Name="UserAvatarDataGrid"
                                  AutoGenerateColumns="False" 
                                  CanUserSortColumns="True" 
                                  IsReadOnly="False"
                                  Background="#FF1E1E1E"
                                  RowBackground="#FF1E1E1E"
                                  AlternatingRowBackground="#FF2D2D30"
                                  RowDetailsVisibilityMode="Visible"
                                  PreviewMouseWheel="UserAvatarDataGrid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <!-- Thumbnail Image -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.Thumbnail}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="100" Height="100" BorderBrush="Gray" BorderThickness="1">
                                                <Image Source="{Binding ThumbnailUrl}" Width="100" Height="100" Stretch="Uniform" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Name -->
                                <DataGridTextColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.Name}" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>

                                <!-- Avatar ID -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.AvatarId}" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                    <Hyperlink NavigateUri="{Binding AvatarId, StringFormat=https://vrchat.com/home/avatar/{0}}"
                                                               RequestNavigate="AvatarHyperlink_RequestNavigate">
                                                        <Run Text="{Binding AvatarId}" />
                                                    </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Platform States -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.IsPC}" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Viewbox Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,4,0">
                                                <Canvas Width="32" Height="32">
                                                    <Path Data="{Binding PCPerformance.IconGeometry}" Fill="{Binding PCPerformance.IconBrush}" Stretch="UniformToFill" Width="24" Height="24"/>
                                                </Canvas>
                                            </Viewbox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.IsQuest}" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Viewbox Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,4,0">
                                                <Canvas Width="32" Height="32">
                                                    <Path Data="{Binding QuestPerformance.IconGeometry}" Fill="{Binding QuestPerformance.IconBrush}" Stretch="UniformToFill" Width="24" Height="24"/>
                                                </Canvas>
                                            </Viewbox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.IsIOS}" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Viewbox Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,4,0">
                                                <Canvas Width="32" Height="32">
                                                    <Path Data="{Binding IOSPerformance.IconGeometry}" Fill="{Binding IOSPerformance.IconBrush}" Stretch="UniformToFill" Width="24" Height="24"/>
                                                </Canvas>
                                            </Viewbox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Date Info -->
                                <DataGridTextColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.CreateDate}" Binding="{Binding CreatedAt}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.UpdateDate}" Binding="{Binding UpdatedAt}" Width="100" IsReadOnly="True"/>

                                <!-- Alert Type -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.AlertType}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AlertType}" 
                                                       Background="{Binding AlertBackground}"
                                                       Foreground="{Binding AlertForeground}"
                                                       Padding="4,2"
                                                       TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AlertTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Value" 
                                                      DisplayMemberPath="Key"
                                                      SelectedValue="{Binding AlertType, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Add Button -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserAvatar.Column.Action}" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{DynamicResource UI.Overlay.UserAvatar.Action.Add}" 
                                                    Click="UserAvatarAdd_Click" 
                                                    Tag="{Binding}"
                                                    Padding="4,2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanAdd}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                            <!-- Row Details Template for Description and Rules -->
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FF3F3F46" BorderThickness="1" Background="#FF252526" Padding="8" Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/> 
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Description Section -->
                                            <Button Content="{DynamicResource UI.Overlay.UserAvatar.Action.SwitchIntoAvatar}" 
                                                Grid.Row="0" Grid.Column="0"
                                                Name="OverlayUseAvatarButton"
                                                DataContext="{Binding}"
                                                Tag="{Binding}"
                                                Click="OverlayUseAvatarButton_Click" 
                                                Margin="0,0,6,0"
                                                IsEnabled="True"/>
                                            <Button Content="{DynamicResource UI.Overlay.UserAvatar.Action.ReportAvatar}" 
                                                Grid.Row="0" Grid.Column="1"
                                                Name="OverlayReportAvatarButton"
                                                DataContext="{Binding}"
                                                Tag="{Binding}"
                                                Click="ReportAvatar_Click"                                                 
                                                Margin="0,0,6,0" Background="#FFCC0000" Foreground="White"
                                                IsEnabled="True"/>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource UI.Overlay.UserAvatar.Column.Description}" 
                                                           FontWeight="Bold" 
                                                           Foreground="#FFE6E6E6" 
                                                           HorizontalAlignment="Left"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Description}" 
                                                           TextWrapping="Wrap" 
                                                           Foreground="#FFE6E6E6"
                                                           MinHeight="50" MaxWidth="500"
                                                           HorizontalAlignment="Left"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>

                            <!-- Cell Style for highlighting owned groups -->
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOwnedByUser}" Value="True">
                                            <Setter Property="Background" Value="{Binding DataContext.FriendBackground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="Foreground" Value="{Binding DataContext.FriendForeground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource UI.Overlay.UserAvatar.Action.SaveAll}" 
                                Click="UserAvatarOverlaySaveChanges_Click" 
                                Tag="UserAvatarDataGrid"
                                Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Name="UserAvatarOverlayCloseButton" 
                                Content="{DynamicResource UI.Overlay.UserAvatar.Action.Close}" 
                                Width="100" 
                                Click="UserAvatarOverlayClose_Click"
                                Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- #endregion User Avatar Management Overlay -->

        <!-- #region User Groups Management Overlay-->
        <Border Name="UserGroupsOverlay" 
                Background="#CC000000" 
                Panel.ZIndex="{x:Static local:TailgrabPanelConst.ZINDEX_LEVEL_OVERLAY}"
                Visibility="Collapsed">
            <Border Background="#FF2D2D30"
                    Height="600"
                    Width="1080"
                    MaxWidth="1080" 
                    MaxHeight="700" 
                    CornerRadius="8"
                    Padding="16"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" 
                               Text="User Groups Management" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#FFE6E6E6"
                               Margin="0,0,0,16"/>

                    <!-- User Info Section -->
                    <GroupBox Grid.Row="1" Header="{DynamicResource UI.Overlay.UserGroups.Group.Title}" Margin="0,0,0,12">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource UI.Overlay.UserGroups.Group.UserId}" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Name="UserGroupsOverlayUserId" VerticalAlignment="Center"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource UI.Overlay.UserGroups.Group.DisplayName}" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Name="UserGroupsOverlayDisplayName" VerticalAlignment="Center"/>
                        </Grid>
                    </GroupBox>
                                      
                    <!-- Groups List -->
                    <ScrollViewer Name="UserGroupsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <DataGrid Name="UserGroupsDataGrid"
                                  AutoGenerateColumns="False" 
                                  CanUserSortColumns="True" 
                                  IsReadOnly="False"
                                  Background="#FF1E1E1E"
                                  RowBackground="#FF1E1E1E"
                                  AlternatingRowBackground="#FF2D2D30"
                                  RowDetailsVisibilityMode="Visible"
                                  PreviewMouseWheel="UserGroupsDataGrid_PreviewMouseWheel">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF404040"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Banner Image -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserGroups.Column.Banner}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="100" Height="100" BorderBrush="Gray" BorderThickness="1">
                                                <Image Source="{Binding BannerUrl}" Width="100" Height="100" Stretch="Uniform" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Icon Image -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserGroups.Column.Icon}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="100" Height="100" BorderBrush="Gray" BorderThickness="1">
                                                <Image Source="{Binding IconUrl}" Width="100" Height="100" Stretch="Uniform" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Name -->
                                <DataGridTextColumn Header="{DynamicResource UI.Overlay.UserGroups.Column.Name}" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>

                                <!-- Short Code -->
                                <DataGridTextColumn Header="{DynamicResource UI.Overlay.UserGroups.Column.ShortCode}" Binding="{Binding ShortCode}" Width="100" IsReadOnly="True"/>

                                <!-- Group ID -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserGroups.Column.GroupId}" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                    <Hyperlink NavigateUri="{Binding GroupId, StringFormat=https://vrchat.com/home/group/{0}}"
                                                               RequestNavigate="GroupHyperlink_RequestNavigate">
                                                        <Run Text="{Binding GroupId}" />
                                                    </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Join State -->
                                <DataGridTextColumn Header="{DynamicResource UI.Overlay.UserGroups.Column.JoinState}" Binding="{Binding JoinState}" Width="100" IsReadOnly="True"/>

                                <!-- Member Count -->
                                <DataGridTextColumn Header="{DynamicResource UI.Overlay.UserGroups.Column.Members}" Binding="{Binding MemberCount}" Width="80" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Alert Type -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserGroups.Column.AlertType}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AlertType}" 
                                                       Background="{Binding AlertBackground}"
                                                       Foreground="{Binding AlertForeground}"
                                                       Padding="4,2"
                                                       TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AlertTypeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Value" 
                                                      DisplayMemberPath="Key"
                                                      SelectedValue="{Binding AlertType, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Add Button -->
                                <DataGridTemplateColumn Header="{DynamicResource UI.Overlay.UserGroups.Column.Action}" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{DynamicResource UI.Overlay.UserGroups.Action.Add}" 
                                                    Click="UserGroupsAdd_Click" 
                                                    Tag="{Binding}"
                                                    Padding="4,2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanAdd}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                            <!-- Row Details Template for Description and Rules -->
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FF3F3F46" BorderThickness="1" Background="#FF252526" Padding="8" Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Description Section -->
                                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource UI.Overlay.UserGroups.Column.Description}" 
                                                           FontWeight="Bold" 
                                                           Foreground="#FFE6E6E6" 
                                                           Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Description}" 
                                                           TextWrapping="Wrap" 
                                                           Foreground="#FFE6E6E6"
                                                           MaxHeight="100"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>

                                            <!-- Rules Section -->
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="{DynamicResource UI.Overlay.UserGroups.Column.Rules}" 
                                                           FontWeight="Bold" 
                                                           Foreground="#FFE6E6E6" 
                                                           Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Rules}" 
                                                           TextWrapping="Wrap" 
                                                           Foreground="#FFE6E6E6"
                                                           MaxHeight="100"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>

                            <!-- Cell Style for highlighting owned groups -->
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOwnedByUser}" Value="True">
                                            <Setter Property="Background" Value="{Binding DataContext.FriendBackground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="Foreground" Value="{Binding DataContext.FriendForeground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource UI.Overlay.UserGroups.Action.SaveAll}" 
                                Click="UserGroupOverlaySaveChanges_Click" 
                                Tag="UserGroupsDataGrid"
                                Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Name="UserGroupsOverlayCloseButton" 
                                Content="{DynamicResource UI.Overlay.UserGroups.Action.Close}" 
                                Width="100" 
                                Click="UserGroupsOverlayClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
