                                                        Content="Ban All" 
                                                        Click="BanMgmtBanAllGroups_Click"
                                                        Padding="4,2"
                                                        Margin="4,0"/>
                                                <Button Grid.Column="6" 
                                                        Content="Unban All" 
                                                        Click="BanMgmtUnbanAllGroups_Click"
                                                        Padding="4,2"
                                                        Margin="4,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Group List -->
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                                            <ItemsControl Name="BanMgmtGroupList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="4" Margin="0,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="300"/>
                                                                    <ColumnDefinition Width="250"/>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" 
                                                                           Text="{Binding GroupId}" 
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0"/>
                                                                <TextBlock Grid.Column="1" 
                                                                           Text="{Binding GroupName}" 
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0"/>
                                                                <TextBlock Grid.Column="2" 
                                                                           Text="{Binding Status}" 
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0"
                                                                           Foreground="{Binding StatusColor}"/>
                                                                <Button Grid.Column="3" 
                                                                        Content="Remove Group" 
                                                                        Click="BanMgmtRemoveGroup_Click"
                                                                        Tag="{Binding}"
                                                                        Padding="4,2"
                                                                        Margin="4,0"/>
                                                                <Button Grid.Column="5" 
                                                                        Content="Ban" 
                                                                        Click="BanMgmtBanUser_Click"
                                                                        Tag="{Binding}"
                                                                        IsEnabled="{Binding CanBan}"
                                                                        Padding="4,2"
                                                                        Margin="4,0"/>
                                                                <Button Grid.Column="6" 
                                                                        Content="Unban" 
                                                                        Click="BanMgmtUnbanUser_Click"
                                                                        Tag="{Binding}"
                                                                        IsEnabled="{Binding CanUnban}"
                                                                        Padding="4,2"
                                                                        Margin="4,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Add Group Section -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Label Grid.Column="0" 
                                                   Content="Add Group ID:" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" 
                                                     Name="BanMgmtAddGroupIdTextBox"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                            <Button Grid.Column="2" 
                                                    Content="Add Group" 
                                                    Click="BanMgmtAddGroup_Click"
                                                    Padding="4,2"/>
                                        </Grid>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </Grid>


