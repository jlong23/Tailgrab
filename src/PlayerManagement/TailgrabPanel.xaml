                                </GroupBox>

                                <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                                    <Button Content="Save Config" Click="SaveAlerts_Click" Width="120" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Colors">
