<Window x:Class="Tailgrab.PlayerManagement.TailgrabPanel"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:Tailgrab.PlayerManagement"
Title="Tailgrab Player Panel"
        Width="1080" Height="750"
        FontFamily="Segoe UI"
        Language="en-US"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:MinutesToHoursMinutesConverter x:Key="MinutesToHoursMinutesConverter"/>
        <local:SoundNotNoneConverter x:Key="SoundNotNoneConverter"/>

        <!-- Dark theme TabItem style with template -->
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1,1,1,0" 
                                CornerRadius="3,3,0,0"
                                Margin="2,0,2,0">
                            <ContentPresenter x:Name="ContentSite"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            ContentSource="Header"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Disabled state -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#FF37373A"/>
                                <Setter Property="Foreground" Value="#FF828282"/>
                            </Trigger>
                            <!-- Selected state -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF46466D"/>
                                <Setter Property="Foreground" Value="#FFC8C881"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,0"/>
                            </Trigger>
                            <!-- Mouse over state (only when not selected) -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#FF3C3C3F"/>
                                <Setter Property="Foreground" Value="#FFE6E6E6"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable ComboBox ItemTemplate for Single Color Display -->
        <DataTemplate x:Key="SingleColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="20" Height="20" Fill="{Binding Brush}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Reusable ComboBox ItemTemplate for Dual Color Display -->
        <DataTemplate x:Key="DualColorItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="20" Height="20" Fill="{Binding BackgroundBrush}" Margin="0,0,4,0"/>
                <Rectangle Width="20" Height="20" Fill="{Binding ForegroundBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Reusable ListViewItem Style with Dynamic Colors -->
        <Style x:Key="PlayerListViewItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Background" Value="{Binding DataContext.NormalBackground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Foreground" Value="{Binding DataContext.NormalForeground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HighlightClass}" Value="Normal">
                    <Setter Property="Background" Value="{Binding DataContext.NormalBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="Foreground" Value="{Binding DataContext.NormalForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighlightClass}" Value="Friend">
                    <Setter Property="Background" Value="{Binding DataContext.FriendBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="Foreground" Value="{Binding DataContext.FriendForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighlightClass}" Value="Class01">
                    <Setter Property="Background" Value="{Binding DataContext.Class01Background, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="Foreground" Value="{Binding DataContext.Class01Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighlightClass}" Value="Class02">
                    <Setter Property="Background" Value="{Binding DataContext.Class02Background, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="Foreground" Value="{Binding DataContext.Class02Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighlightClass}" Value="Class03">
                    <Setter Property="Background" Value="{Binding DataContext.Class03Background, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="Foreground" Value="{Binding DataContext.Class03Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HighlightClass}" Value="Class04">
                    <Setter Property="Background" Value="{Binding DataContext.Class04Background, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter Property="Foreground" Value="{Binding DataContext.Class04Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.SelectedBackground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="Foreground" Value="{Binding DataContext.SelectedForeground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.MouseOverBackground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="Foreground" Value="{Binding DataContext.MouseOverForeground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="8" Grid.Row="0">
            <TabControl x:Name="MainTabControl">
                <TabItem Header="Active Players">
                    <Grid Name="ActivePlayerLayoutGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="172*"/>
                            <ColumnDefinition Width="357*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="267*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="ActivePlayerGridRow" Height="*" MinHeight="100"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Grid.Row="0" Grid.ColumnSpan="2">
                            <TextBox Name="ActiveFilterBox" Width="300" Margin="0,0,8,0" />
                            <Button Content="Apply Filter" Click="ActiveApplyFilter_Click" Margin="0,0,6,0"/>
                            <Button Content="Clear Filter" Click="ActiveClearFilter_Click"/>
                        </StackPanel>

                        <ListView Name="ActiveListView" ItemsSource="{Binding ActiveView}" SelectedItem="{Binding SelectedActive, Mode=TwoWay}" Grid.ColumnSpan="2" Margin="0,26,0,0" Grid.RowSpan="2">
                            <ListView.ItemContainerStyle>
                                <StaticResource ResourceKey="PlayerListViewItemStyle"/>
                            </ListView.ItemContainerStyle>
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Filter">
                                        <MenuItem Header="Filter by selected DisplayName" Click="ActiveFilterBySelected_Click"/>
                                    </MenuItem>
                                    <MenuItem Header="View Groups" Click="ActiveViewUserGroups_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>

                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="180">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Display Name" Tag="DisplayName" Click="GridViewColumnHeader_Click"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Age" Tag="Age" Click="GridViewColumnHeader_Click" HorizontalContentAlignment="Center"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProfileElapsedTime, Mode=OneWay}" Width="40" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Trust" Tag="Trust" Click="GridViewColumnHeader_Click" HorizontalContentAlignment="Center"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border ClipToBounds="True" ToolTip="{Binding UserTrust}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Viewbox Width="16" Height="16">
                                                            <Path Data="{Binding UserTrustIconGeometry}" 
                                                                  Fill="{Binding UserTrustIconBrush}"
                                                                  Stroke="White"
                                                                  StrokeThickness="0.5"/>
                                                        </Viewbox>
                                                        <Viewbox Width="16" Height="16">
                                                            <Path Data="{Binding AgeVerifiedIconGeometry}" 
                                                                  Fill="{Binding AgeVerifiedIconBrush}"
                                                                  Stroke="White"
                                                                  StrokeThickness="0.5"/>
                                                        </Viewbox>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="180">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Avatar Name" Tag="AvatarName" Click="GridViewColumnHeader_Click"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AvatarName}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="160">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Name="ActivePlayerInstanceStart" Content="Instance Start ▼" Tag="InstanceStartTime" Click="GridViewColumnHeader_Click"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding InstanceStartTime}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="280">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Alert Messages" Tag="UserId" Click="GridViewColumnHeader_Click"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border ClipToBounds="True" TextElement.Foreground="Black"
                                                        ToolTip="{Binding AlertMessages.Count}">
                                                    <ItemsControl ItemsSource="{Binding AlertMessages}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,5,0"
                                                                            ToolTip="{Binding IconClass}">
                                                                    <Viewbox Width="16" Height="16" 
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,4,0">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Data="{Binding IconGeometry}" 
                                                                                  Fill="{Binding IconBrush}"/>
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <TextBlock Text="{Binding Description}" 
                                                                               VerticalAlignment="Center"
                                                                               TextWrapping="NoWrap"
                                                                               FontWeight="Bold"
                                                                               FontSize="12"
                                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Browser column -->
                                    <GridViewColumn Width="80">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Browser" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                <Hyperlink NavigateUri="{Binding UserId, StringFormat=https://vrchat.com/home/user/{0}}"
                                                           RequestNavigate="UserHyperlink_RequestNavigate">
                                                    Open
                                                </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Actions column -->
                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Copy" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Copy" Click="CopyPlayer_Click" Padding="4,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Actions column -->
                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Rpt" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Report" Click="ReportPlayer_Click" Padding="4,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Ban column -->
                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Ban" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ban" Click="BanPlayer_Click" Padding="4,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Groups" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Groups" Click="ActiveViewUserGroups_Click" Padding="4,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                </GridView>
                            </ListView.View>
                        </ListView>

                        <GridSplitter Name="ActivePlayers_Horz"  Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#FF3F3F46" ShowsPreview="False" ResizeDirection="Rows" Grid.ColumnSpan="2" DragCompleted="GridSplitter_DragCompleted"/>

                        <Grid Margin="0,0,0,6" Grid.Row="3" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" Name="ActivePlayerGridColumn"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" Margin="0,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Image Source="{Binding SelectedActive.ProfileUrl, Mode=OneWay}" 
                                           Width="100" 
                                           Height="100"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,4">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedActive.ProfileUrl, Converter={x:Static local:StringNotNullOrEmptyConverter.Instance}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <TextBlock Name="UserPofileBox" TextWrapping="Wrap" Foreground="#FFE6E6E6">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}User Profile:&#x0a;{0}&#x0a;&#x0a;AI Evaluation:&#x0a;{1}" Mode="OneWay">
                                                <Binding Path="SelectedActive.Profile" Mode="OneWay" FallbackValue="" TargetNullValue=""/>
                                                <Binding Path="SelectedActive.AIEval" Mode="OneWay" FallbackValue="" TargetNullValue=""/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>

                            <GridSplitter Name="ActivePlayers_Vert" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#FF3F3F46" ShowsPreview="False" ResizeDirection="Columns" DragCompleted="GridSplitter_DragCompleted"/>

                            <ScrollViewer Grid.Column="2" Margin="0,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBox Name="UserAlertsBox" TextWrapping="Wrap" Text="{Binding SelectedActive.History, Mode=OneWay, FallbackValue='', TargetNullValue=''}" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Past Players">
                    <Grid Name="PastPlayerLayoutGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="172*"/>
                            <ColumnDefinition Width="357*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="267*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="PastPlayerGridRow" Height="*" MinHeight="100"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Grid.Row="0" Grid.ColumnSpan="2">
                            <TextBox Name="PastFilterBox" Width="300" Margin="0,0,8,0" />
                            <Button Content="Apply Filter" Click="PastApplyFilter_Click" Margin="0,0,6,0"/>
                            <Button Content="Clear Filter" Click="PastClearFilter_Click"/>
                        </StackPanel>

                        <ListView Name="PastListView" ItemsSource="{Binding PastView}" SelectedItem="{Binding SelectedPast, Mode=TwoWay}" Grid.ColumnSpan="2" Margin="0,26,0,0" Grid.RowSpan="2">
                            <ListView.ItemContainerStyle>
                                <StaticResource ResourceKey="PlayerListViewItemStyle"/>
                            </ListView.ItemContainerStyle>

                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Filter">
                                        <MenuItem Header="Filter by selected DisplayName" Click="PastFilterBySelected_Click"/>
                                    </MenuItem>
                                    <MenuItem Header="View Groups" Click="PastViewUserGroups_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>

                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="180">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Display Name" Tag="DisplayName" Click="GridViewColumnHeader_Click"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Age" Tag="Age" Click="GridViewColumnHeader_Click" HorizontalContentAlignment="Center"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProfileElapsedTime, Mode=OneWay}" Width="40" TextAlignment="Right"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Trust" Tag="Trust" Click="GridViewColumnHeader_Click" HorizontalContentAlignment="Center"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border ClipToBounds="True" ToolTip="{Binding UserTrust}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Viewbox Width="24" Height="24">
                                                            <Path Data="{Binding UserTrustIconGeometry}" 
                                                                  Fill="{Binding UserTrustIconBrush}"
                                                                  Stroke="White"
                                                                  StrokeThickness="0.5"/>
                                                        </Viewbox>
                                                        <Viewbox Width="24" Height="24">
                                                            <Path Data="{Binding AgeVerifiedIconGeometry}" 
                                                                  Fill="{Binding AgeVerifiedIconBrush}"
                                                                  Stroke="White"
                                                                  StrokeThickness="0.5"/>
                                                        </Viewbox>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="180">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Avatar Name" Tag="AvatarName" Click="GridViewColumnHeader_Click"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AvatarName}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="160">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Name="PastPlayerInstanceEnd" Content="Instance End ▼" Tag="InstanceEndTime" Click="GridViewColumnHeader_Click"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding InstanceEndTime}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="280">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Alert Messages" Tag="UserId" Click="GridViewColumnHeader_Click"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border ClipToBounds="True" TextElement.Foreground="Black">
                                                    <ItemsControl ItemsSource="{Binding AlertMessages}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,5,0">
                                                                    <Viewbox Width="16" Height="16" 
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,4,0">
                                                                        <Canvas Width="24" Height="24">
                                                                            <Path Data="{Binding IconGeometry}" 
                                                                                  Fill="{Binding IconBrush}"/>
                                                                        </Canvas>
                                                                    </Viewbox>
                                                                    <TextBlock Text="{Binding Description}" 
                                                                               VerticalAlignment="Center"
                                                                               TextWrapping="NoWrap"
                                                                               FontWeight="Bold"
                                                                               FontSize="12"
                                                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Browser column -->
                                    <GridViewColumn Width="80">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Browser" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                <Hyperlink NavigateUri="{Binding UserId, StringFormat=https://vrchat.com/home/user/{0}}"
                                                           RequestNavigate="UserHyperlink_RequestNavigate">
                                                    Open
                                                </Hyperlink>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Actions column -->
                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Copy" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Copy" Click="CopyPlayer_Click" Padding="4,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Actions column -->
                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Rpt" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Report" Click="ReportPlayerPast_Click" Padding="4,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Actions column -->
                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Ban" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Ban" Click="BanPlayerPast_Click" Padding="4,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Width="60">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="Groups" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Groups" Click="ActiveViewUserGroups_Click" Padding="4,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>


                                </GridView>
                            </ListView.View>
                        </ListView>

                        <GridSplitter Name="PastPlayers_Horz" Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#FF3F3F46" ShowsPreview="False" ResizeDirection="Rows" Grid.ColumnSpan="2" DragCompleted="GridSplitter_DragCompleted"/>

                        <Grid Margin="0,0,0,6" Grid.Row="3" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" Name="PastPlayerGridColumn"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" Margin="0,0,4,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Image Source="{Binding SelectedPast.ProfileUrl, Mode=OneWay}" 
                                           Width="100" 
                                           Height="100"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,4">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPast.ProfileUrl, Converter={x:Static local:StringNotNullOrEmptyConverter.Instance}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

