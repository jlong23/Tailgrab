                Grid.RowSpan="3" Grid.ColumnSpan="2"
                Background="#CC000000" 
                Panel.ZIndex="{x:Static local:TailgrabPanelConst.ZINDEX_LEVEL_OVERLAY}"
                Visibility="Collapsed">
            <Border Background="#FF2D2D30" 
                    Width="550" Height="500"
                    MaxWidth="650" MaxHeight="600" 
                    CornerRadius="8" Padding="16"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" 
                               Text="{DynamicResource UI.Overlay.TestProfileAIPrompt.Title}" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="#FFE6E6E6"
                               Margin="0,0,0,16"/>

                    <!-- User ID -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <Label Content="{DynamicResource UI.Overlay.TestProfileAIPrompt.UserID}" FontWeight="Bold" Foreground="#FFE6E6E6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="OverlayTestProfileEvalUserIdTextBox" Grid.Column="0" IsReadOnly="True"/>
                        </Grid>
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Label Content="{DynamicResource UI.Overlay.TestProfileAIPrompt.Profile}" FontWeight="Bold" Foreground="#FFE6E6E6"/>
                        <TextBox Name="OverlayTestProfileEvalProfileTextBox" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 MaxHeight="150" Height="130"/>
                    </StackPanel>

                    <!-- Report Reason -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <Label Content="{DynamicResource UI.Overlay.TestProfileAIPrompt.AI_Evaluation}" FontWeight="Bold" Foreground="#FFE6E6E6"/>
                        <TextBox Name="OverlayTestProfileEvalEvaluationTextBox" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True"
                                 MaxHeight="200" Height="130"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="OverlayTestProfileEvalOkButton" Content="{DynamicResource UI.Overlay.TestProfileAIPrompt.Action.Close}" Width="100" Click="TestProfilePrompt_Ok_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- #endregion Test Profile Prompt AI Evaluation Results Overlay -->

        <!-- #region Test Image Prompt AI Evaluation Results Overlay -->
        <Border Name="OverlayTestImageEval" 
                Background="#CC000000" 
                Panel.ZIndex="{x:Static local:TailgrabPanelConst.ZINDEX_LEVEL_OVERLAY}"
                Visibility="Collapsed">
            <Border Background="#FF2D2D30" 
                    Width="800" Height="600"
                    MaxWidth="1200" MaxHeight="700" 
                    CornerRadius="8" Padding="16"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" 
                               Text="{DynamicResource UI.Overlay.TestImageAIPrompt.Title}" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="#FFE6E6E6"
                               Margin="0,0,0,16"/>

                    <!-- ListView for Test Images -->
                    <ListView Grid.Row="1" 
                              Name="TestImageAIEvalListView"
                              ItemsSource="{Binding TestImageAIEvalItems}"
                              Margin="0,0,0,12"
                              Background="#FF2D2D30"
                              BorderBrush="#FF3F3F46" BorderThickness="1"
                              ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FF3F3F46" 
                                        BorderThickness="0,0,0,1" Padding="8" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Image Display -->
                                        <Border Grid.Column="0" 
                                                Width="200" Height="200"
                                                BorderBrush="#FF3F3F46" BorderThickness="1"
                                                Margin="0,0,12,0">
                                            <Image Source="{Binding ImagePath}" 
                                                   Stretch="Uniform"
                                                   Width="200" Height="200"/>
                                        </Border>

                                        <!-- AI Evaluation Text -->
                                        <Border Grid.Column="1"
                                                BorderBrush="#FF3F3F46" BorderThickness="1"
                                                Padding="8"
                                                Background="#FF1E1E1E">

                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{Binding AIEvaluation}" 
                                                           TextWrapping="Wrap"
                                                           Foreground="#FFE6E6E6"
                                                           FontFamily="Consolas" FontSize="12" 
                                                           Width="450" Height="200"/>
                                            </ScrollViewer>

                                        </Border>

                                        <Border Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,5,0">
                                                <Viewbox Width="32" Height="32" 
                                                         VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <Canvas Width="32" Height="32">
                                                        <Path Data="{Binding AlertInfo.IconGeometry}" 
                                                              Fill="{Binding AlertInfo.IconBrush}"
                                                              Stretch="UniformToFill"
                                                              Width="32" Height="32"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Close Button -->
                    <Button Grid.Row="2" 
                            Content="{DynamicResource UI.Overlay.TestImageAIPrompt.Action.Close}" 
                            Width="100" HorizontalAlignment="Right" Padding="8,4"
                            Click="CloseTestImageEval_Click"/>
                </Grid>
            </Border>
        </Border>
        <!-- #endregion Test Image Prompt AI Evaluation Results Overlay -->

        <!-- #region Status Message Overlay -->
        <Border Name="OverlayMessage" 
                Background="#CC000000" 
                Panel.ZIndex="{x:Static local:TailgrabPanelConst.ZINDEX_LEVEL_MESSAGE_OVERLAY}"
                Visibility="Collapsed">
            <Border Background="#FF2D2D30" 
                    MaxWidth="1080" MaxHeight="700" 
                    CornerRadius="8" Padding="16"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" 
                               Text="{Binding OverlayMessageTitle}" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="#FFE6E6E6"
                               Margin="0,0,0,16"/>

                    <!-- Message -->
                    <TextBox Name="OverlayMessageBodyTextBox" 
                             Grid.Row="1"
                             TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             MaxHeight="500" Height="130"/>

                    <!-- Close Button -->
                    <Button Grid.Row="2" 
                            Content="{DynamicResource UI.Overlay.TestImageAIPrompt.Action.Close}" 
                            Width="100" HorizontalAlignment="Right" Padding="8,4"
                            Click="HideOverlayMessage"/>
                </Grid>
            </Border>
        </Border>
        <!-- #endregion Status Message Overlay -->

        <!-- #region Status Bar -->
        <StatusBar Grid.Row="1" Background="#FF2D2D30" Foreground="#FFE6E6E6">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock>
                    <Run Text="{DynamicResource UI.StatusBar.Instaamce}"/>
                    <Run Text="{Binding InstanceId, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="{DynamicResource UI.StatusBar.AvatarQueue}"/>
                    <Run Text="{Binding AvatarQueueLength, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="{DynamicResource UI.StatusBar.AiQueue}"/>
                    <Run Text="{Binding OllamaQueueLength, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="{Binding GroupGistStatus, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="{DynamicResource UI.StatusBar.Elapsed}"/>
                    <Run Text="{Binding ElapsedTime, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
        <!-- #endregion Status Bar -->
    </Grid>
</Window>
