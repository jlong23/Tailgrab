<Window x:Class="Tailgrab.PlayerManagement.SelectHandlerTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Handler Type" 
        SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        Foreground="{DynamicResource SystemControlForeground}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Select a Handler Type:" Margin="0,0,0,6" FontWeight="Bold" />
            <ComboBox Name="HandlerTypeCombo" Height="24" Width="200" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="OkButton" Content="OK" Padding="12,4" Margin="0,0,6,0" Click="OkButton_Click" />
            <Button Name="CancelButton" Content="Cancel" Padding="12,4" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
