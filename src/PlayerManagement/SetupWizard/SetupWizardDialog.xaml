<Window x:Class="Tailgrab.PlayerManagement.SetupWizard.SetupWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SetupWizard.Title}"
        Height="600" 
        Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/src/Resources/ThemeResources.xaml" />
                <ResourceDictionary Source="/src/Resources/ControlStyles.xaml" />
                <ResourceDictionary Source="/src/Resources/localization.en-US.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Step Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Control.Background}" Padding="20,15,20,15" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border.Regular}">
            <StackPanel>
                <TextBlock x:Name="StepTitleText" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Control.Foreground}"/>
                <TextBlock x:Name="StepDescriptionText" FontSize="12" Foreground="{DynamicResource Brush.Control.Disabled.Foreground}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Step Content Area -->
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="StepContentPresenter"/>
        </ScrollViewer>

        <!-- Footer with Navigation Buttons -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Control.Background}" Padding="20" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border.Regular}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ProgressBar x:Name="StepProgressBar" Width="150" Height="6" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Highlight.Background}"/>
                <TextBlock x:Name="StepCountText" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Control.Disabled.Foreground}"/>
                <Button x:Name="BackButton" Content="{DynamicResource SetupWizard.ButtonBack}" Width="80" Height="35" Margin="0,0,10,0" Click="BackButton_Click"/>
                <Button x:Name="NextButton" Content="{DynamicResource SetupWizard.ButtonNext}" Width="80" Height="35" Background="{DynamicResource Brush.Highlight.Background}" Foreground="{DynamicResource Brush.Highlight.Foreground}" Click="NextButton_Click"/>
                <Button x:Name="CancelButton" Content="{DynamicResource SetupWizard.ButtonCancel}" Width="80" Height="35" Margin="10,0,0,0" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Status/Loading Overlay -->
        <Border x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed" Opacity="0.8">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource SetupWizard.LoadingMessage}" Foreground="{DynamicResource Brush.Control.Foreground}" FontSize="14" TextAlignment="Center" Margin="0,0,0,10"/>
                <ProgressBar Width="300" Height="8" IsIndeterminate="True" Foreground="{DynamicResource Brush.Highlight.Background}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
