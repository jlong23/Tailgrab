<Window x:Class="Tailgrab.PlayerManagement.SetupWizard.SetupWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tailgrab Setup Wizard" 
        Height="600" 
        Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Step Header -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="20,15,20,15" BorderThickness="0,0,0,1" BorderBrush="#D0D0D0">
            <StackPanel>
                <TextBlock x:Name="StepTitleText" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock x:Name="StepDescriptionText" FontSize="12" Foreground="#666666" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Step Content Area -->
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <ContentPresenter x:Name="StepContentPresenter"/>
        </ScrollViewer>

        <!-- Footer with Navigation Buttons -->
        <Border Grid.Row="2" Background="#F9F9F9" Padding="20" BorderThickness="0,1,0,0" BorderBrush="#D0D0D0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ProgressBar x:Name="StepProgressBar" Width="150" Height="6" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="#4CAF50"/>
                <TextBlock x:Name="StepCountText" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#666666"/>
                <Button x:Name="BackButton" Content="Back" Width="80" Height="35" Margin="0,0,10,0" Click="BackButton_Click"/>
                <Button x:Name="NextButton" Content="Next" Width="80" Height="35" Background="#4CAF50" Foreground="White" Click="NextButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="35" Margin="10,0,0,0" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Status/Loading Overlay -->
        <Border x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#00000080" Visibility="Collapsed" Opacity="0.8">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Testing credentials..." Foreground="White" FontSize="14" TextAlignment="Center" Margin="0,0,0,10"/>
                <ProgressBar Width="300" Height="8" IsIndeterminate="True" Foreground="#4CAF50"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
