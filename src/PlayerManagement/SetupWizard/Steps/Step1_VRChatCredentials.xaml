<UserControl x:Class="Tailgrab.PlayerManagement.SetupWizard.Steps.Step1_VRChatCredentials"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 Height="Auto">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/src/Resources/localization.en-US.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<StackPanel Margin="0,20,0,20">
		<TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333"
				   Text="{DynamicResource SetupWizard.Step01.CredentialsDescription}"/>

		<TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333"
				   Text="{DynamicResource SetupWizard.Step01.APIExplanation}"/>

		<StackPanel Margin="0,0,0,15">
			<TextBlock Text="{DynamicResource SetupWizard.Step01.UsernameLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
			<TextBox x:Name="UsernameTextBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
		</StackPanel>

		<StackPanel Margin="0,0,0,15">
			<TextBlock Text="{DynamicResource SetupWizard.Step01.PasswordLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
        </StackPanel>

        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333"
                   Text="{DynamicResource SetupWizard.Step01.TwoFAQuestion}"/>

        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333">
            <Hyperlink NavigateUri="https://wiki.vrchat.com/wiki/Two-Factor_Authentication_(2FA)#Setup." RequestNavigate="Hyperlink_RequestNavigate">
                <Run Text="{DynamicResource SetupWizard.Step01.TwoFALearnMore}"/>
            </Hyperlink>
        </TextBlock>

        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333"
                   Text="{DynamicResource SetupWizard.Step01.TwoFASetupNote}"/>


        <StackPanel Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TwoFANo" Content="{DynamicResource SetupWizard.Step01.TwoFANo}" Margin="0,0,20,0" IsChecked="True" VerticalAlignment="Center" Foreground="#333333"/>
                <RadioButton x:Name="TwoFAEmail" Content="{DynamicResource SetupWizard.Step01.TwoFAEmail}" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="#333333"/>
                <RadioButton x:Name="TwoFAAuthenticator" Content="{DynamicResource SetupWizard.Step01.TwoFAAuthenticator}" VerticalAlignment="Center" Foreground="#333333"/>
            </StackPanel>
        </StackPanel>

		<StackPanel x:Name="TwoFAPanel" Visibility="Collapsed" Margin="0,0,0,15">
			<TextBlock Text="{DynamicResource SetupWizard.Step01.TwoFAKeyLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
			<PasswordBox x:Name="TwoFAKeyBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
			<TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333"
					   Text="{DynamicResource SetupWizard.Step01.TwoFAKeyDescription}"/>
		</StackPanel>

        <Border Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="1" Padding="10" CornerRadius="4">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"
                           Text="{DynamicResource SetupWizard.Step01.NoteLabel}"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#333333"
                           Text="{DynamicResource SetupWizard.Step01.SecurityNote}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorMessageText" FontSize="14" FontWeight="Bold" Foreground="#D32F2F" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
