<UserControl x:Class="Tailgrab.PlayerManagement.SetupWizard.Steps.Step1_VRChatCredentials"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto">
    <StackPanel Margin="0,20,0,20">
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333">
            Enter your VRChat Web API credentials. These are the same credentials you use to log into VRChat web site.
        </TextBlock>

		<TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333">
			The VRChat Web API allows Tailgrab to interact with your VRChat account programmatically, getting user information, friends, and other data. Your credentials are stored securely and encrypted in your Windows registry.
		</TextBlock>

		<StackPanel Margin="0,0,0,15">
            <TextBlock Text="VRChat Username:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
            <TextBox x:Name="UsernameTextBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="VRChat Password:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
        </StackPanel>

        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333">
            Does your VRChat account have 2-Factor Authentication enabled?
        </TextBlock>

        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333">
            <Hyperlink NavigateUri="https://wiki.vrchat.com/wiki/Two-Factor_Authentication_(2FA)#Setup." RequestNavigate="Hyperlink_RequestNavigate">
                Click here to learn more about setting up Two-Factor Authentication (2FA) for your VRChat account.                
            </Hyperlink>
        </TextBlock>

        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333">
            (Don't forget when it shows you the QR Code to also click on the 'Enter Code Manualy' and copy the 32 Character Secret Code into Tailgrab's 2FA Secret Key field. This is not the 'recovery codes')
        </TextBlock>


        <StackPanel Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TwoFANo" Content="No" Margin="0,0,20,0" IsChecked="True" VerticalAlignment="Center" Foreground="#333333"/>
                <RadioButton x:Name="TwoFAEmail" Content="Yes - Prompted for 6 Digit Code" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="#333333"/>
                <RadioButton x:Name="TwoFAAuthenticator" Content="Yes - Use OTP Generator Code; Automatic Re-login" VerticalAlignment="Center" Foreground="#333333"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="TwoFAPanel" Visibility="Collapsed" Margin="0,0,0,15">
            <TextBlock Text="2FA Secret Key (from Authenticator App):" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
			<PasswordBox x:Name="TwoFAKeyBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333">
                Enter the 'secret code' that was generated by VRChat for your authenticator app (string of 32 characters). Tailgrab will generate the 6 Digit OTP codes automatically when needed.
            </TextBlock>
        </StackPanel>

        <Border Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="1" Padding="10" CornerRadius="4">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333">Note:</TextBlock>
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#333333">
                    Your credentials are encrypted and stored securely in your Windows registry. They are only for VRChat API authentication.
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorMessageText" FontSize="14" FontWeight="Bold" Foreground="#D32F2F" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
