<UserControl x:Class="Tailgrab.PlayerManagement.SetupWizard.Steps.Step6_MCPServer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/src/Resources/localization.en-US.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,20,0,20">
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333"
                   Text="{DynamicResource SetupWizard.Step06.Description}"/>

        <StackPanel Margin="0,0,0,20">
            <CheckBox x:Name="EnableMCPCheckbox" Content="{DynamicResource SetupWizard.Step06.EnableMCPLabel}" Margin="0,0,0,10" IsChecked="False" Foreground="#333333"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666"
                       Text="{DynamicResource SetupWizard.Step06.EnableMCPDescription}"/>
        </StackPanel>

        <!-- MCP Settings -->
        <Border x:Name="MCPSettingsSection" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,15" Visibility="Collapsed">
            <StackPanel>
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step06.ServerPortLabel}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="MCPPortBox" Height="35" Padding="10,8" Text="7575" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#999999"
                               Text="{DynamicResource SetupWizard.Step06.ServerPortDescription}"/>
                </StackPanel>

                <Border Background="#E8F5E9" BorderBrush="#81C784" BorderThickness="1" Padding="10" CornerRadius="4">
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#1B5E20"
                               Text="{DynamicResource SetupWizard.Step06.ServerAccessInfo}"/>
                </Border>
            </StackPanel>
        </Border>

		<Border Background="#FFF3E0" BorderBrush="#FFB74D" BorderThickness="1" Padding="10" CornerRadius="4">
			<StackPanel>
				<TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Foreground="#E65100"
						   Text="{DynamicResource SetupWizard.Step06.WhatIsMCPTitle}"/>
				<TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#BF360C"
						   Text="{DynamicResource SetupWizard.Step06.WhatIsMCPDescription}"/>
			</StackPanel>
		</Border>

        <Border Background="LightBlue" BorderBrush="Aqua" BorderThickness="1" Padding="10" CornerRadius="4">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,0,5" Foreground="Black"
                           Text="{DynamicResource SetupWizard.Step06.NoteTitle}"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="Black"
                           Text="{DynamicResource SetupWizard.Step06.FirewallNote}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorMessageText" FontSize="12" Foreground="#D32F2F" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
