<UserControl x:Class="Tailgrab.PlayerManagement.SetupWizard.Steps.Step2_GistConfiguration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto">
    <StackPanel Margin="0,20,0,20">
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333">
            Configure your GitHub Gist settings for sharing watched avatars and groups with team members.
        </TextBlock>

        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#666666">
            Do you have a shared Gist that you use to synchronize watched avatars and groups?
        </TextBlock>

        <TextBlock FontSize="11" Margin="0,0,0,15">
            <Hyperlink NavigateUri="https://docs.github.com/en/get-started/writing-on-github/editing-and-sharing-content-with-gists/creating-gists">
                Click here to Learn more about creating Gists.
            </Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <RadioButton x:Name="HaveSharedGist" Content="Yes, I have a shared Gist" Margin="0,0,20,0" IsChecked="True" VerticalAlignment="Center" Foreground="#333333"/>
            <RadioButton x:Name="NoSharedGist" Content="No, I'll enter URLs manually" VerticalAlignment="Center" Foreground="#333333"/>
        </StackPanel>

        <!-- Shared Gist Section -->
        <Border x:Name="SharedGistSection" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333">Shared Gist Configuration</TextBlock>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Gist ID:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="SharedGistIdBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333">
                        The 32-character ID from your Gist URL (e.g., https://gist.github.com/username/GIST_ID)
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Are you the administrator of this Gist?" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NotGistAdmin" Content="No, I just have access" Margin="0,0,20,0" IsChecked="True" VerticalAlignment="Center" Foreground="#333333"/>
						<RadioButton x:Name="IsGistAdmin" Content="Yes, I'm the admin - enable ONE CLICK Upload" VerticalAlignment="Center" Foreground="#333333"/>
					</StackPanel>
                </StackPanel>

                <StackPanel x:Name="PATSection" Margin="0,0,0,0">
                    <TextBlock Text="GitHub Personal Access Token (optional):" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <PasswordBox x:Name="GitHubPATBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333">
                        Required for ONE CLICK Upload. Create a token at https://github.com/settings/tokens with 'gist' scope.
                    </TextBlock>
                    <TextBlock FontSize="11" Margin="0,0,0,15">
                        <Hyperlink NavigateUri="https://github.com/electerm/electerm/wiki/Create-personal-access-token">
                            Click here to Learn more about creating a Personal Access Token and setting the 'gist' scope.
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Manual URLs Section -->
        <Border x:Name="ManualUrlsSection" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,15" Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333">Manual Gist URLs</TextBlock>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Avatar Gist URL:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="AvatarGistUrlBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333">
                        Full GitHub Gist URL (e.g., https://gist.github.com/username/GIST_ID)
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="Group Gist URL:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="GroupGistUrlBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333">
                        Full GitHub Gist URL (e.g., https://gist.github.com/username/GIST_ID)
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <CheckBox x:Name="SkipGistCheckbox" Content="Skip Gist configuration for now (can be configured later)" Foreground="#333333" Margin="0,0,0,15"/>

        <TextBlock x:Name="ErrorMessageText" FontSize="14" FontWeight="Bold" Foreground="#D32F2F" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
