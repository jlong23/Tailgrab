<UserControl x:Class="Tailgrab.PlayerManagement.SetupWizard.Steps.Step2_GistConfiguration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/src/Resources/localization.en-US.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,20,0,20">
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333"
                   Text="{DynamicResource SetupWizard.Step02.Description}"/>

        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#666666"
                   Text="{DynamicResource SetupWizard.Step02.GistQuestion}"/>

        <TextBlock FontSize="11" Margin="0,0,0,15">
            <Hyperlink NavigateUri="https://docs.github.com/en/get-started/writing-on-github/editing-and-sharing-content-with-gists/creating-gists">
                <Run Text="{DynamicResource SetupWizard.Step02.LearnGists}"/>
            </Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <RadioButton x:Name="HaveSharedGist" Content="{DynamicResource SetupWizard.Step02.HaveSharedGist}" Margin="0,0,20,0" IsChecked="True" VerticalAlignment="Center" Foreground="#333333"/>
            <RadioButton x:Name="NoSharedGist" Content="{DynamicResource SetupWizard.Step02.NoSharedGist}" VerticalAlignment="Center" Foreground="#333333"/>
        </StackPanel>

		<!-- Shared Gist Section -->
		<Border x:Name="SharedGistSection" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,15">
			<StackPanel>
				<TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"
						   Text="{DynamicResource SetupWizard.Step02.SharedGistSectionTitle}"/>

				<StackPanel Margin="0,0,0,15">
					<TextBlock Text="{DynamicResource SetupWizard.Step02.GistIdLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
					<TextBox x:Name="SharedGistIdBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
					<TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333"
							   Text="{DynamicResource SetupWizard.Step02.GistIdDescription}"/>
				</StackPanel>

				<StackPanel Margin="0,0,0,15">
					<TextBlock Text="{DynamicResource SetupWizard.Step02.AdminQuestion}" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"/>
					<StackPanel Orientation="Horizontal">
						<RadioButton x:Name="NotGistAdmin" Content="{DynamicResource SetupWizard.Step02.NotAdmin}" Margin="0,0,20,0" IsChecked="True" VerticalAlignment="Center" Foreground="#333333"/>
						<RadioButton x:Name="IsGistAdmin" Content="{DynamicResource SetupWizard.Step02.IsAdmin}" VerticalAlignment="Center" Foreground="#333333"/>
					</StackPanel>
				</StackPanel>

				<StackPanel x:Name="PATSection" Margin="0,0,0,0">
					<TextBlock Text="{DynamicResource SetupWizard.Step02.GithubPATLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
					<PasswordBox x:Name="GitHubPATBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
					<TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333"
							   Text="{DynamicResource SetupWizard.Step02.GithubPATDescription}"/>
					<TextBlock FontSize="11" Margin="0,0,0,15">
						<Hyperlink NavigateUri="https://github.com/electerm/electerm/wiki/Create-personal-access-token">
							<Run Text="{DynamicResource SetupWizard.Step02.LearnPAT}"/>
						</Hyperlink>
					</TextBlock>
				</StackPanel>
			</StackPanel>
		</Border>

        <!-- Manual URLs Section -->
        <Border x:Name="ManualUrlsSection" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,15" Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"
                           Text="{DynamicResource SetupWizard.Step02.ManualUrlsSectionTitle}"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step02.AvatarGistUrlLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="AvatarGistUrlBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333"
                               Text="{DynamicResource SetupWizard.Step02.AvatarGistUrlDescription}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="{DynamicResource SetupWizard.Step02.GroupGistUrlLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="GroupGistUrlBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333"
                               Text="{DynamicResource SetupWizard.Step02.GroupGistUrlDescription}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <CheckBox x:Name="SkipGistCheckbox" Content="{DynamicResource SetupWizard.Step02.SkipCheckbox}" Foreground="#333333" Margin="0,0,0,15"/>

        <TextBlock x:Name="ErrorMessageText" FontSize="14" FontWeight="Bold" Foreground="#D32F2F" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
