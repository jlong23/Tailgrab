<UserControl x:Class="Tailgrab.PlayerManagement.SetupWizard.Steps.Step5_AIEvaluation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/src/Resources/localization.en-US.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,20,0,20">
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333"
                   Text="{DynamicResource SetupWizard.Step05.Description}"/>

        <StackPanel Margin="0,0,0,20">
            <CheckBox x:Name="EnableAICheckbox" Content="{DynamicResource SetupWizard.Step05.EnableAILabel}" Margin="0,0,0,10" IsChecked="False" Foreground="#333333"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#333333"
                       Text="{DynamicResource SetupWizard.Step05.EnableAIDescription}"/>
        </StackPanel>

        <!-- AI Settings -->
        <Border x:Name="AISettingsSection" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,15" Visibility="Visible">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"
                           Text="{DynamicResource SetupWizard.Step05.OLLAMAConfigurationTitle}"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step05.OLLAMAEndpointLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="OLLAMAEndpointBox" Height="35" Padding="10,8" Text="https://ollama.com/" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333"
                               Text="{DynamicResource SetupWizard.Step05.OLLAMAEndpointDescription}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step05.APIKeyLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <PasswordBox x:Name="OLLAMAKeyBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333"
                               Text="{DynamicResource SetupWizard.Step05.APIKeyDescription}"/>
                    <TextBlock FontSize="11">
                        <Hyperlink NavigateUri="https://ollama.com/settings/keys" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="{DynamicResource SetupWizard.Step05.OLLAMACloudLink}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step05.ModelNameLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="OLLAMAModelBox" Height="35" Padding="10,8" Text="gemma4:31b" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#999999"
                               Text="{DynamicResource SetupWizard.Step05.ModelNameDescription}"/>
                </StackPanel>

                <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" Padding="10" CornerRadius="4">
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#1565C0"
                               Text="{DynamicResource SetupWizard.Step05.InformationBox}"/>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorMessageText" FontSize="12" Foreground="#D32F2F" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
