<UserControl x:Class="Tailgrab.PlayerManagement.SetupWizard.Steps.Step5_AIEvaluation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto">
    <StackPanel Margin="0,20,0,20">
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333">
            Configure AI-powered content evaluation for profile text and images using Ollama free(*) models.
        </TextBlock>

        <StackPanel Margin="0,0,0,20">
            <CheckBox x:Name="EnableAICheckbox" Content="Enable AI Evaluation of Profiles and Images" Margin="0,0,0,10" IsChecked="False" Foreground="#333333"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#333333">
                Requires Ollama to be installed either locally and running (May be slow); or using the Free Tier of Ollama Cloud. Supports classification of inappropriate content.
            </TextBlock>
        </StackPanel>

        <!-- AI Settings -->
        <Border x:Name="AISettingsSection" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,15" Visibility="Visible">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333">OLLAMA Configuration</TextBlock>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="OLLAMA Endpoint:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="OLLAMAEndpointBox" Height="35" Padding="10,8" Text="https://ollama.com/" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333">
                        URL where OLLAMA is running (typically http://localhost:11434 or https://ollama.com/)
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="API Key (if required):" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <PasswordBox x:Name="OLLAMAKeyBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#333333">
                        Leave blank if OLLAMA is running locally without authentication.
                    </TextBlock>
                    <TextBlock FontSize="11">
                        <Hyperlink NavigateUri="https://ollama.com/settings/keys" RequestNavigate="Hyperlink_RequestNavigate">
                            Click here to visit Ollama Cloud for free tier account access and API key generation.
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Model Name:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="OLLAMAModelBox" Height="35" Padding="10,8" Text="gemma4:31b" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#999999">
                        The OLLAMA model to use for evaluation. Common options: gemma4:31b, llama2, neural-chat, etc.
                    </TextBlock>
                </StackPanel>

                <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" Padding="10" CornerRadius="4">
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#1565C0">
                        💡 Evaluation prompts can be customized in the AI Tab after setup is complete.
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorMessageText" FontSize="12" Foreground="#D32F2F" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
