<UserControl x:Class="Tailgrab.PlayerManagement.SetupWizard.Steps.Step4_OBSIntegration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/src/Resources/localization.en-US.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,20,0,20">
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333"
                   Text="{DynamicResource SetupWizard.Step04.Description}"/>

        <StackPanel Margin="0,0,0,20">
            <CheckBox x:Name="EnableOBSCheckbox" Content="{DynamicResource SetupWizard.Step04.EnableOBSLabel}" Margin="0,0,0,10" IsChecked="False" Foreground="#333333"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#333333"
                       Text="{DynamicResource SetupWizard.Step04.EnableOBSDescription}"/>
        </StackPanel>

        <!-- OBS Settings -->
        <Border x:Name="OBSSettingsSection" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,15" Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"
                           Text="{DynamicResource SetupWizard.Step04.OBSWebSocketSettingsTitle}"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step04.WebSocketUriLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="OBSWebSocketURIBox" Height="35" Padding="10,8" Text="ws://localhost:4455" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step04.WebSocketPasswordLabel}" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <PasswordBox x:Name="OBSPasswordBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Foreground="#DDDDDD"/>

                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"
                           Text="{DynamicResource SetupWizard.Step04.RecordingFeaturesTitle}"/>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="StartReplayBufferCheckbox" Content="{DynamicResource SetupWizard.Step04.StartReplayBufferLabel}" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666"
                               Text="{DynamicResource SetupWizard.Step04.StartReplayBufferDescription}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="StartVirtualCameraCheckbox" Content="{DynamicResource SetupWizard.Step04.StartVirtualCameraLabel}" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666"
                               Text="{DynamicResource SetupWizard.Step04.StartVirtualCameraDescription}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="RecordOnWorldJoinCheckbox" Content="{DynamicResource SetupWizard.Step04.RecordOnWorldJoinLabel}" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666"
                               Text="{DynamicResource SetupWizard.Step04.RecordOnWorldJoinDescription}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <CheckBox x:Name="RecordKickBanCheckbox" Content="{DynamicResource SetupWizard.Step04.RecordKickBanLabel}" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666"
                               Text="{DynamicResource SetupWizard.Step04.RecordKickBanDescription}"/>
                </StackPanel>

                <StackPanel x:Name="KickBanSceneSection" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step04.KickBanSceneLabel}" FontWeight="Bold" Margin="20,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="KickBanSceneNameBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock Text="{DynamicResource SetupWizard.Step04.BrowserSourceLabel}" FontWeight="Bold" Margin="20,10,0,5" Foreground="#333333"/>
                    <TextBox x:Name="KickBanBrowserNameBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <CheckBox x:Name="RecordImageCheckbox" Content="{DynamicResource SetupWizard.Step04.RecordImageLabel}" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666"
                               Text="{DynamicResource SetupWizard.Step04.RecordImageDescription}"/>
                </StackPanel>

                <StackPanel x:Name="CustomSpawnSceneSection" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step04.CustomSpawnSceneLabel}" FontWeight="Bold" Margin="20,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="ImageEventSceneNameBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock Text="{DynamicResource SetupWizard.Step04.BrowserSourceLabel}" FontWeight="Bold" Margin="20,10,0,5" Foreground="#333333"/>
                    <TextBox x:Name="ImageEventBrowserNameBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Foreground="#DDDDDD"/>

                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"
                           Text="{DynamicResource SetupWizard.Step04.ChapterGenerationTitle}"/>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="CreateMP4ChaptersCheckbox" Content="{DynamicResource SetupWizard.Step04.CreateMP4ChaptersLabel}" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666"
                               Text="{DynamicResource SetupWizard.Step04.CreateMP4ChaptersDescription}"/>
                </StackPanel>

                <StackPanel x:Name="FFMpegSection" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="{DynamicResource SetupWizard.Step04.FFMpegPathLabel}" FontWeight="Bold" Margin="20,0,0,5"/>
                    <TextBox x:Name="FFMpegPathBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" Margin="0,0,0,15">
                        <Hyperlink NavigateUri="https://www.gyan.dev/ffmpeg/builds/">
                            <Run Text="{DynamicResource SetupWizard.Step04.DownloadFFMpeg}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="CreateMKVChaptersCheckbox" Content="{DynamicResource SetupWizard.Step04.CreateMKVChaptersLabel}" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666"
                               Text="{DynamicResource SetupWizard.Step04.CreateMKVChaptersDescription}"/>
                </StackPanel>

                <StackPanel x:Name="MKVMergeSection" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource SetupWizard.Step04.MKVMergePathLabel}" FontWeight="Bold" Margin="20,0,0,5"/>
                    <TextBox x:Name="MKVMergePathBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" Margin="0,0,0,15">
                        <Hyperlink NavigateUri="https://mkvtoolnix.download/downloads.html#windows">
                            <Run Text="{DynamicResource SetupWizard.Step04.DownloadMKVToolNix}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorMessageText" FontSize="12" Foreground="#D32F2F" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
