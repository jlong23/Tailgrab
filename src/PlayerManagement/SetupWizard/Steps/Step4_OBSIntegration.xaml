<UserControl x:Class="Tailgrab.PlayerManagement.SetupWizard.Steps.Step4_OBSIntegration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto">
    <StackPanel Margin="0,20,0,20">
        <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#333333">
            Configure OBS (Open Broadcaster Software) integration for automated recording and streaming features.
        </TextBlock>

        <StackPanel Margin="0,0,0,20">
            <CheckBox x:Name="EnableOBSCheckbox" Content="Enable OBS Integration" Margin="0,0,0,10" IsChecked="False" Foreground="#333333"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#333333">
                Requires OBS to be running before tailgrab; with the WebSocket Server enabled (Tools &gt; WebSocket Server Settings).
            </TextBlock>
        </StackPanel>

        <!-- OBS Settings -->
        <Border x:Name="OBSSettingsSection" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" CornerRadius="4" Margin="0,0,0,15" Visibility="Collapsed">
            <StackPanel>
                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333">OBS WebSocket Settings</TextBlock>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="WebSocket URI:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="OBSWebSocketURIBox" Height="35" Padding="10,8" Text="ws://localhost:4455" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="WebSocket Password (if configured):" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333333"/>
                    <PasswordBox x:Name="OBSPasswordBox" Height="35" Padding="10,8" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Foreground="#DDDDDD"/>

                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333">Recording Features</TextBlock>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="StartReplayBufferCheckbox" Content="Start Replay Buffer automatically" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666">
                        Keeps a rolling buffer of recent video for quick capture.
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="StartVirtualCameraCheckbox" Content="Start Virtual Camera automatically" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666">
                        Provides a virtual camera source for other applications.
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="RecordOnWorldJoinCheckbox" Content="Record when you join a world" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666">
                        Automatically starts recording when entering a VRChat world.
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <CheckBox x:Name="RecordKickBanCheckbox" Content="Save Replay Buffer on kick/ban" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666">
                        Automatically saves the replay buffer when there is a Vote to Kick, Group Kick or Ban event.
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="KickBanSceneSection" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="Scene Name for Kick/Ban Events:" FontWeight="Bold" Margin="20,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="KickBanSceneNameBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock Text="Browser Source Name:" FontWeight="Bold" Margin="20,10,0,5" Foreground="#333333"/>
                    <TextBox x:Name="KickBanBrowserNameBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <CheckBox x:Name="RecordImageCheckbox" Content="Save Replay Buffer on User Image Event" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666">
                        Automatically saves the replay buffer when a Sticker, Emoji, or Print is spawned.
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="CustomSpawnSceneSection" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="Scene Name for User Image Events:" FontWeight="Bold" Margin="20,0,0,5" Foreground="#333333"/>
                    <TextBox x:Name="ImageEventSceneNameBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock Text="Browser Source Name:" FontWeight="Bold" Margin="20,10,0,5" Foreground="#333333"/>
                    <TextBox x:Name="ImageEventBrowserNameBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                </StackPanel>

                <Separator Margin="0,15,0,15" Foreground="#DDDDDD"/>

                <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333">Chapter Generation (Video Editing)</TextBlock>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="CreateMP4ChaptersCheckbox" Content="Create MP4 chapter markers" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666">
                        Requires FFMpeg to be installed.
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="FFMpegSection" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Text="FFMpeg Path:" FontWeight="Bold" Margin="20,0,0,5"/>
                    <TextBox x:Name="FFMpegPathBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" Margin="0,0,0,15">
                        <Hyperlink NavigateUri="https://www.gyan.dev/ffmpeg/builds/">
                            Click here to download FFMpeg for Windows 11 (Release Builds: ffmpeg-release-full.7z)
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="CreateMKVChaptersCheckbox" Content="Create MKV chapter markers" Margin="0,0,0,5" IsChecked="False" Foreground="#333333"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,0" Foreground="#666666">
                        Requires MKVMerge to be installed.
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="MKVMergeSection" Visibility="Collapsed">
                    <TextBlock Text="MKVMerge Path:" FontWeight="Bold" Margin="20,0,0,5"/>
                    <TextBox x:Name="MKVMergePathBox" Height="35" Padding="10,8" Margin="20,0,0,0" Foreground="#333333" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    <TextBlock FontSize="11" Margin="0,0,0,15">
                        <Hyperlink NavigateUri="https://mkvtoolnix.download/downloads.html#windows">
                            Click here to download MKVToolNix for Windows 11 (mkvtoolnix-64-bit-102.0-setup.exe)
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorMessageText" FontSize="12" Foreground="#D32F2F" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
