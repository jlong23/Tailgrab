    <!-- Setup Wizard - Step 1: VRChat Credentials -->
    <sys:String x:Key="SetupWizard.Step01.CredentialsDescription">Enter your VRChat Web API credentials. These are the same credentials you use to log into VRChat web site.</sys:String>
    <sys:String x:Key="SetupWizard.Step01.APIExplanation">The VRChat Web API allows Tailgrab to interact with your VRChat account programmatically, getting user information, friends, and other data. Your credentials are stored securely and encrypted in your Windows registry.</sys:String>
    <sys:String x:Key="SetupWizard.Step01.UsernameLabel">VRChat Username:</sys:String>
    <sys:String x:Key="SetupWizard.Step01.PasswordLabel">VRChat Password:</sys:String>
    <sys:String x:Key="SetupWizard.Step01.TwoFAQuestion">Does your VRChat account have 2-Factor Authentication enabled?</sys:String>
    <sys:String x:Key="SetupWizard.Step01.TwoFALearnMore">Click here to learn more about setting up Two-Factor Authentication (2FA) for your VRChat account.</sys:String>
    <sys:String x:Key="SetupWizard.Step01.TwoFASetupNote">(Don't forget when it shows you the QR Code to also click on the 'Enter Code Manualy' and copy the 32 Character Secret Code into Tailgrab's 2FA Secret Key field. This is not the 'recovery codes')</sys:String>
    <sys:String x:Key="SetupWizard.Step01.TwoFANo">No</sys:String>
    <sys:String x:Key="SetupWizard.Step01.TwoFAEmail">Yes - Prompted for 6 Digit Code</sys:String>
    <sys:String x:Key="SetupWizard.Step01.TwoFAAuthenticator">Yes - Use OTP Generator Code; Automatic Re-login</sys:String>
    <sys:String x:Key="SetupWizard.Step01.TwoFAKeyLabel">2FA Secret Key (from Authenticator App):</sys:String>
    <sys:String x:Key="SetupWizard.Step01.TwoFAKeyDescription">Enter the 'secret code' that was generated by VRChat for your authenticator app (string of 32 characters). Tailgrab will generate the 6 Digit OTP codes automatically when needed.</sys:String>
    <sys:String x:Key="SetupWizard.Step01.NoteLabel">Note:</sys:String>
    <sys:String x:Key="SetupWizard.Step01.SecurityNote">Your credentials are encrypted and stored securely in your Windows registry. They are only for VRChat API authentication.</sys:String>

    <!-- Setup Wizard - Step 2: Gist Configuration -->
    <sys:String x:Key="SetupWizard.Step02.Description">Configure your GitHub Gist settings for sharing watched avatars and groups with team members.</sys:String>
    <sys:String x:Key="SetupWizard.Step02.GistQuestion">Do you have a shared Gist that you use to synchronize watched avatars and groups?</sys:String>
    <sys:String x:Key="SetupWizard.Step02.LearnGists">Click here to Learn more about creating Gists.</sys:String>
    <sys:String x:Key="SetupWizard.Step02.HaveSharedGist">Yes, I have a shared Gist</sys:String>
    <sys:String x:Key="SetupWizard.Step02.NoSharedGist">No, I'll enter URLs manually</sys:String>
    <sys:String x:Key="SetupWizard.Step02.SharedGistSectionTitle">Shared Gist Configuration</sys:String>
    <sys:String x:Key="SetupWizard.Step02.GistIdLabel">Gist ID:</sys:String>
    <sys:String x:Key="SetupWizard.Step02.GistIdDescription">The 32-character ID from your Gist URL (e.g., https://gist.github.com/username/GIST_ID)</sys:String>
    <sys:String x:Key="SetupWizard.Step02.AdminQuestion">Are you the administrator of this Gist?</sys:String>
    <sys:String x:Key="SetupWizard.Step02.NotAdmin">No, I just have access</sys:String>
    <sys:String x:Key="SetupWizard.Step02.IsAdmin">Yes, I'm the admin - enable ONE CLICK Upload</sys:String>
    <sys:String x:Key="SetupWizard.Step02.GithubPATLabel">GitHub Personal Access Token (optional):</sys:String>
    <sys:String x:Key="SetupWizard.Step02.GithubPATDescription">Required for ONE CLICK Upload. Create a token at https://github.com/settings/tokens with 'gist' scope.</sys:String>
    <sys:String x:Key="SetupWizard.Step02.LearnPAT">Click here to Learn more about creating a Personal Access Token and setting the 'gist' scope.</sys:String>
    <sys:String x:Key="SetupWizard.Step02.ManualUrlsSectionTitle">Manual Gist URLs</sys:String>
    <sys:String x:Key="SetupWizard.Step02.AvatarGistUrlLabel">Avatar Gist URL:</sys:String>
    <sys:String x:Key="SetupWizard.Step02.AvatarGistUrlDescription">Full GitHub Gist URL (e.g., https://gist.github.com/username/GIST_ID)</sys:String>
    <sys:String x:Key="SetupWizard.Step02.GroupGistUrlLabel">Group Gist URL:</sys:String>
    <sys:String x:Key="SetupWizard.Step02.GroupGistUrlDescription">Full GitHub Gist URL (e.g., https://gist.github.com/username/GIST_ID)</sys:String>
    <sys:String x:Key="SetupWizard.Step02.SkipCheckbox">Skip Gist configuration for now (can be configured later)</sys:String>

    <!-- Setup Wizard - Step 3: Behavior Flags -->
    <sys:String x:Key="SetupWizard.Step03.Description">Configure caching behavior for discovered avatars and groups.</sys:String>
    <sys:String x:Key="SetupWizard.Step03.DiscoveredAvatarCachingLabel">Cache discovered avatars locally</sys:String>
    <sys:String x:Key="SetupWizard.Step03.DiscoveredAvatarCachingDescription">Collect public avatars you experience for removal or reporting later.</sys:String>
    <sys:String x:Key="SetupWizard.Step03.DiscoveredGroupCachingLabel">Cache discovered groups locally</sys:String>
    <sys:String x:Key="SetupWizard.Step03.DiscoveredGroupCachingDescription">Collects groups all user groups you experience in the instance for reporting/flagging later.</sys:String>
    <sys:String x:Key="SetupWizard.Step03.ModeratedAvatarCachingLabel">Cache moderated avatars locally</sys:String>
    <sys:String x:Key="SetupWizard.Step03.ModeratedAvatarCachingDescription">Adds 'Hide Globally' avatars in your account as Nuisance Avatars on the next startup.</sys:String>
    <sys:String x:Key="SetupWizard.Step03.XSOverlayDescription">If you use XS Overlay in VR, you can configure this to popup notifications in VR for alerts of that level and higher.</sys:String>
    <sys:String x:Key="SetupWizard.Step03.XSOverlayNone">None</sys:String>
    <sys:String x:Key="SetupWizard.Step03.XSOverlayWatch">Watch</sys:String>
    <sys:String x:Key="SetupWizard.Step03.XSOverlayNuisance">Nuisance</sys:String>
    <sys:String x:Key="SetupWizard.Step03.XSOverlayCrasher">Crasher</sys:String>
    <sys:String x:Key="SetupWizard.Step03.InformationLabel">Information:</sys:String>
    <sys:String x:Key="SetupWizard.Step03.CachingNote">Caching information can help with detection of Crashing Avatars and Groups, but will use local disk space and may affect application startup time.</sys:String>

