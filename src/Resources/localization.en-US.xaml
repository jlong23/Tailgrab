    <!-- Setup Wizard - Main Dialog -->
    <sys:String x:Key="SetupWizard.Title">Tailgrab Setup Wizard</sys:String>
    <sys:String x:Key="SetupWizard.ButtonBack">Back</sys:String>
    <sys:String x:Key="SetupWizard.ButtonNext">Next</sys:String>
